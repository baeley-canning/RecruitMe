[Unit]
Description=RecruitMe remote control agent — long-poll commands from admin portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recruitme
ExecStart=/usr/bin/node /opt/recruitme/appliance/control-agent/agent.mjs
Restart=always
RestartSec=15
# Memory cap small — long-poll loop barely uses RAM
MemoryMax=128M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
