[Unit]
Description=RecruitMe heartbeat — 5-min vitals POST to admin portal
After=network-online.target recruitme-app.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/recruitme-heartbeat
User=recruitme
# Failure is logged but doesn't take down the timer. Portal unreachable
# is the expected case during network blips; the next tick retries.
SuccessExitStatus=0
