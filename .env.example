# Database — PostgreSQL (Railway provides this automatically via ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.railway.app"

# Owner-account seed — REQUIRED in production. Boot will fail if unset.
# Username defaults to "Cassius" for backwards compatibility with existing DBs;
# password must always be set explicitly (no default — refuses to ship a known cred).
SEED_OWNER_USERNAME=Cassius
SEED_OWNER_PASSWORD=

# AI Provider: "claude" | "openai"
# When BOTH ANTHROPIC_API_KEY and OPENAI_API_KEY are set, the configured
# AI_PROVIDER is tried first and the other one takes over automatically
# if it fails. When only one key is set, that's the only provider used.
AI_PROVIDER=claude

# Claude (Anthropic) — default primary
# Models: claude-haiku-4-5-20251001 (fast/cheap) | claude-sonnet-4-6 (best quality)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI — failover (or set AI_PROVIDER=openai to flip the order)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily AI spend ceiling per org (USD). Once reached, score-all returns 429
# until the rolling 24h window drops the org back under the cap. Set generously
# enough for normal usage but tight enough to cap a runaway loop. Default: 5.
AI_DAILY_SPEND_CAP_USD=5

# SerpAPI — enables automatic LinkedIn profile search (100 searches/month free)
# Sign up at https://serpapi.com
SERPAPI_API_KEY=

# People Data Labs — profile enrichment + candidate search (100 free calls/month)
# Sign up at https://peopledatalabs.com
PDL_API_KEY=

# CV at-rest encryption key — 32 bytes, base64. If unset, a key is generated
# and stored in the Setting table on first use. SET THIS EXPLICITLY in any
# centralized/cloud deployment so the key is reproducible from outside the DB
# (a restore from a backup predating the Setting row would otherwise make every
# encrypted CV unreadable). Generate with: openssl rand -base64 32
CV_ENCRYPTION_KEY=

# Blob store (S3-compatible, e.g. Cloudflare R2) for candidate files (CVs,
# photos). When ALL FOUR are set, new uploads store the encrypted blob in the
# bucket and keep only a pointer (CandidateFile.storageKey) in Postgres; when
# unset, blobs stay inline in the DB (legacy behaviour) and nothing changes.
# Move existing rows out of Postgres with: node scripts/migrate-files-to-r2.mjs --apply
# R2 example endpoint: https://<account-id>.r2.cloudflarestorage.com
BLOB_S3_ENDPOINT=
BLOB_S3_BUCKET=
BLOB_S3_ACCESS_KEY_ID=
BLOB_S3_SECRET_ACCESS_KEY=
BLOB_S3_REGION=auto

# App URL
NEXT_PUBLIC_APP_URL=https://your-app.railway.app
