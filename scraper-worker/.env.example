# ── Scraper Worker Configuration ──────────────────────────────────────────────
#
# FOR AI HANDOFF: Copy this to .env on the Raspberry Pi (or Fly.io secrets).
# NEVER commit .env to git. NEVER send these values to Railway.
#
# HOW TO CONNECT TO RAILWAY:
#   1. In RecruitMe web UI, go to Settings → create an API key (owner only).
#      POST /api/v1/keys { "name": "scraper-worker-pi" } → copy the raw key.
#   2. Set RAILWAY_API_URL to your Railway app URL (e.g. https://recruitme.up.railway.app)
#   3. Set SCRAPER_API_KEY to the raw key from step 1
#   4. Set SCRAPER_ENABLED=true in Railway environment variables (not here)
#   5. Start the worker: npm start (or pm2 start dist/index.js --name scraper-worker)

# ── Railway connection ─────────────────────────────────────────────────────────
RAILWAY_API_URL=https://your-app.up.railway.app
SCRAPER_API_KEY=rm_your_api_key_here

# ── Worker identity ────────────────────────────────────────────────────────────
# Unique name for this Pi node — shows in Railway's ScrapeJob.workerId field
WORKER_ID=pi-01

# ── Polling ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=15000

# ── Session encryption ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key encrypts the LinkedIn/SEEK/JobAdder session cookies stored in ./sessions/
SESSION_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ── LinkedIn credentials (operator's own account) ─────────────────────────────
LINKEDIN_EMAIL=you@youragency.co.nz
LINKEDIN_PASSWORD=your_linkedin_password

# ── SEEK Talent credentials ────────────────────────────────────────────────────
SEEK_EMAIL=you@youragency.co.nz
SEEK_PASSWORD=your_seek_password

# ── JobAdder credentials ───────────────────────────────────────────────────────
# If you have API access, set the access token directly.
# If using OAuth: run the OAuth flow in your browser, copy the token.
JOBADDER_ACCESS_TOKEN=

# ── IP / Proxy (Fly.io path only — leave blank on Pi) ─────────────────────────
# On Pi: leave blank — the 4G modem provides the carrier IP automatically
# On Fly.io: set to your residential proxy endpoint (Brightdata/Smartproxy)
# Format: http://username:password@proxy-host:port
HTTP_PROXY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max profiles scraped per hour per platform (safety cap, humanizer adds jitter)
LINKEDIN_HOURLY_CAP=8
SEEK_HOURLY_CAP=15
