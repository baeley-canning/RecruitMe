# Railway app URL (where the RecruitMe Next.js app is deployed)
RAILWAY_API_URL=https://your-app.railway.app

# Secret shared with Railway — must match SCRAPER_SECRET env var on Railway
SCRAPER_SECRET=generate-with-openssl-rand-base64-32

# LinkedIn credentials (the operator's own account)
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# SEEK Talent credentials
SEEK_EMAIL=your@email.com
SEEK_PASSWORD=yourpassword

# How often to poll for new jobs (milliseconds). Default: 15000 (15s)
POLL_INTERVAL_MS=15000

# ── LinkedIn discovery (the SERP replacement) ───────────────────────────────
# SCRAPER_DISCOVERY_ENABLED: master switch for LinkedIn people-search harvesting.
# SCRAPER_DAILY_SEARCH_CAP: max LinkedIn searches/day (guardrail).
# SCRAPER_SEARCH_MAX_PAGES: how many results pages to harvest per search.
#   1 (default) = first page only (~10 cards) — safest, historical behaviour.
#   Raise toward LinkedIn-like volume (~10×N cards) at the cost of higher
#   block-detection risk; each extra page is the highest-detectability move.
#   Clamped 1..10. If you raise this, also raise SCRAPER_DAILY_SEARCH_CAP and
#   watch the logs for "linkedin_challenge" auth walls.
SCRAPER_DISCOVERY_ENABLED=false
SCRAPER_DAILY_SEARCH_CAP=10
SCRAPER_SEARCH_MAX_PAGES=1

# Optional: residential proxy for IP masking (Brightdata, Smartproxy, etc.)
# Leave blank to use the machine's own IP (e.g. 4G dongle or office internet)
# HTTP_PROXY=http://user:pass@proxy.brightdata.com:22225

# Session encryption key — 32 random bytes as hex. Keep this secret.
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Llama scoring offload (paired with Railway's LLAMA_SCORE_OFFLOAD=1) ──────
# When Claude runs out of tokens, Railway enqueues kind="score" jobs carrying a
# prompt; this worker runs them against the box's LOCAL Ollama and POSTs the raw
# text back (Railway does all the scoring math). Ollama must be running locally.
#   - OLLAMA_BASE_URL: the box's local Ollama OpenAI-compatible endpoint.
#   - OLLAMA_SCORE_MODEL: a 1.5B is free + always-on but weak; bump to a 3B
#     (e.g. qwen2.5:3b) if the box has RAM headroom for better JSON adherence.
#   - OLLAMA_SCORE_TIMEOUT_MS: hard ceiling per scoring call (1.5B is slow).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_SCORE_MODEL=qwen2.5:1.5b
OLLAMA_SCORE_TIMEOUT_MS=120000
