generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin", "darwin-arm64", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                  String    @id @default(cuid())
  title               String
  company             String?
  location            String?
  location2           String? // Optional secondary location for hybrid / dual-site roles (e.g. Wellington + Christchurch). Used by location-fit scoring so a candidate in either metro scores 100.
  rawJd               String
  parsedRole          String? // JSON string: parsed AI output
  salaryMin           Int? // NZD yearly minimum (optional)
  salaryMax           Int? // NZD yearly maximum (optional)
  scoringWeights      String? // JSON: ScoringWeights override for this job; null = use org/default
  shareToken          String?   @unique // opaque random token for read-only public shortlist URL; null = sharing disabled
  shareTokenExpiresAt DateTime? // tokens expire after 30d; the public route 404s once past
  isRemote            Boolean   @default(false)
  status              String    @default("active") // active | closed | on-hold
  lastScoredAt        DateTime? // set by score-all; prevents re-runs within cooldown window
  lastParsedAt        DateTime? // set by re-analyse; UI shows "re-score recommended" when > lastScoredAt
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  candidates     Candidate[]
  fetchSessions  FetchSession[]
  searchSessions SearchSession[]
  savedSearches  SavedSearch[]
  parseHistory   JobParseHistory[]
  orgId          String?
  org            Org?              @relation(fields: [orgId], references: [id])
  clientId       String? // CRM: which client this job is for (Stage 1, flag-gated)
  client         Client?           @relation(fields: [clientId], references: [id])

  @@index([orgId])
  @@index([status])
  @@index([clientId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Org {
  id                  String              @id @default(cuid())
  name                String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  users               User[]
  jobs                Job[]
  candidateIdentities CandidateIdentity[]
  scraperTokens       ScraperApiToken[]
  clients             Client[]
}

// Bearer tokens for headless ingest clients (the mini-PC scraper pulling
// JobAdder/LinkedIn/SEEK profiles). Distinct from User Basic-auth: a scraper
// is a machine, not a person, and gets a revocable, org-scoped, rate-limit-
// tunable credential. Only the SHA-256 hash of the token is stored; the
// plaintext is shown once at creation and never persisted.
model ScraperApiToken {
  id         String    @id @default(cuid())
  orgId      String?   // null = owner-scope (ingest into any org), mirrors auth model elsewhere
  org        Org?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label      String    // human label, e.g. "thinkcentre-scraper"
  tokenHash  String    @unique // SHA-256 hex of the bearer token; plaintext never stored
  lastUsedAt DateTime?
  revokedAt  DateTime? // set to disable without deleting (keeps audit trail)
  expiresAt  DateTime? // optional hard expiry
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

// Work queue for the external scraper worker (mini-PC running Patchright).
// The worker polls GET /api/scraper/jobs for `pending` rows, claims them
// (status → processing), scrapes LinkedIn/SEEK, then PATCHes the result back.
// scraper-ingestion.ts turns a completed result into a Candidate row. No
// unique constraints (poll/claim is status-driven), so this deploys additively.
model ScrapeJob {
  id          String   @id @default(cuid())
  orgId       String
  platform    String // "linkedin" | "seek" | "jobadder"
  profileUrl  String // the URL being scraped
  status      String   @default("pending") // pending | processing | completed | failed
  result      String? // JSON: { profileText, name, headline, location, seekUrl?, linkedinUrl? }
  error       String?
  retryCount  Int      @default(0)
  candidateId String? // set after ingestion creates/updates a Candidate row
  identityId  String? // set after identity resolution runs
  requestedBy String? // userId who triggered the scrape; null = system-initiated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, platform])
  @@index([status, createdAt]) // worker poll query
}

// ── CRM (Stage 1, flag-gated FEATURES_CRM_ENABLED) ─────────────────────────
// Recruitment-client records + candidate→client submissions + placement/fee
// tracking. All additive; no unique constraints.
model Client {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id])
  name           String
  industry       String?
  website        String?
  primaryContact String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  jobs           Job[]
  submissions    Submission[]
  placements     Placement[]

  @@index([orgId])
}

model Submission {
  id             String    @id @default(cuid())
  orgId          String
  jobId          String
  clientId       String?
  candidateId    String
  submittedAt    DateTime  @default(now())
  submittedBy    String? // userId
  matchScore     Int? // snapshot at time of submission
  cvVersion      String?
  notes          String?
  status         String    @default("sent") // sent|viewed|interested|rejected|on_hold
  clientFeedback String?
  feedbackAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([jobId])
  @@index([candidateId])
  @@index([clientId])
}

model Placement {
  id              String    @id @default(cuid())
  orgId           String
  clientId        String?
  jobId           String?
  candidateId     String
  submissionId    String?
  placedAt        DateTime  @default(now())
  startDate       DateTime?
  salaryPlaced    Int?
  feeType         String    @default("percentage") // fixed|percentage
  feePct          Float?
  feeAmount       Int?
  invoiceRef      String?
  invoicedAt      DateTime?
  paidAt          DateTime?
  guaranteeMonths Int?
  guaranteeExpiry DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([clientId])
  @@index([jobId])
  @@index([candidateId])
}

// ── Reminders + Tags (Stage 2, flag-gated FEATURES_REMINDERS_ENABLED) ──────
model Reminder {
  id          String    @id @default(cuid())
  orgId       String
  userId      String?
  candidateId String?
  jobId       String?
  clientId    String?
  placementId String?
  type        String    @default("follow_up") // follow_up|guarantee_check|client_feedback|custom
  dueAt       DateTime
  note        String?
  dismissed   Boolean   @default(false)
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId])
  @@index([orgId, dismissed, dueAt])
}

model CandidateTag {
  id          String                   @id @default(cuid())
  orgId       String
  label       String
  color       String                   @default("#6366f1")
  createdAt   DateTime                 @default(now())
  assignments CandidateTagAssignment[]

  // NOTE: this @@unique is created in apply-schema-changes.mjs (raw SQL,
  // Prisma's generated name CandidateTag_orgId_label_key) NOT by db push —
  // db push refuses to add a unique constraint without --accept-data-loss.
  @@unique([orgId, label])
  @@index([orgId])
}

model CandidateTagAssignment {
  candidateId String
  tagId       String
  createdAt   DateTime     @default(now())
  tag         CandidateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([candidateId, tagId])
  @@index([candidateId])
  @@index([tagId])
}

// Cross-org library access grant. When org A buys a higher-tier subscription
// to view org B's candidate library, an OrgAccessGrant is created (manually
// by the platform owner via the admin panel). The grant is one-way: viewer
// gains read access to provider's library; provider does NOT automatically
// see viewer's library unless a reciprocal grant exists.
//
// Scope strings (extensible):
//   library_read   — see provider's candidates in the viewer's library view
//   library_full   — also see notes, screening, interview data (sensitive)
//   anonymous      — see only profile text + score, no name/contact
//
// Manual grants only; no Stripe integration in v1. Owner pulls the trigger
// after the org has paid (whatever channel that is) and audits via createdAt
// + grantedByUserId.
model OrgAccessGrant {
  id              String    @id @default(cuid())
  viewerOrgId     String // who can see
  providerOrgId   String // whose library is shared
  scope           String    @default("library_read")
  grantedByUserId String // owner userId who created the grant
  note            String? // free-text — sub tier name, expiry reason, etc.
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@unique([viewerOrgId, providerOrgId, scope])
  @@index([viewerOrgId])
  @@index([providerOrgId])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  role      String   @default("user") // "owner" | "user"
  orgId     String?
  org       Org?     @relation(fields: [orgId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Candidate {
  id                 String  @id @default(cuid())
  jobId              String?
  job                Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  orgId              String? // copied from job.orgId on create; preserved after job deletion for auth scoping
  archivedJobTitle   String? // job title at time of deletion, for library display
  archivedJobCompany String? // job company at time of deletion, for library display

  // Pointer to the per-(org, real-person) identity row. Nullable so existing
  // Candidate rows that haven't been clustered yet keep working — see
  // CandidateIdentity model + scripts/cluster-identities.mjs.
  candidateIdentityId String?
  candidateIdentity   CandidateIdentity? @relation(fields: [candidateIdentityId], references: [id], onDelete: SetNull)

  name                String
  headline            String?
  location            String?
  linkedinUrl         String?
  jobAdderUrl         String? // JobAdder candidate profile URL — set manually until API integration
  seekUrl             String? // SEEK profile URL — set manually now, by the mini-PC scraper later. Identity key (lowest precedence after LinkedIn + JobAdder).
  phone               String? // Primary contact phone — set by Firmable enrichment (preferred mobile; falls back to first available). UI display field.
  firmableData        String? // JSON: full Firmable People response (other phones, emails, deliverability flags). Source-of-truth for "what else did the lookup return".
  firmableEnrichedAt  DateTime? // Last successful Firmable lookup; gates the 90-day re-enrichment check.
  profileText         String? // Raw pasted/captured profile text
  profileTextHash     String? // Written after every score; cleared when profile is updated. Used by the UI stale indicator — if matchScore is set but this is null, the profile was refreshed since last score.
  matchScore          Int?
  matchReason         String? // AI JSON: { summary, strengths, gaps }
  fetchPriorityScore  Int?
  fetchPriorityReason String? // JSON: why this search hit is/isn't worth fetching before full scoring
  acceptanceScore     Int?
  acceptanceReason    String? // AI JSON: { likelihood, headline, signals, summary }
  scoreBreakdown      String? // Structured scoring JSON: ScoreBreakdown type
  notes               String? // Recruiter notes
  screeningData       String? // JSON: {availability,salaryExpectation,visaStatus,noticePeriod,motivations,notes,screenedAt}
  interviewNotes      String? // JSON: {date,interviewer,format,impression,technical,culture,recommendation,updatedAt}
  status              String    @default("new") // new | reviewing | shortlisted | contacted | interviewing | offer_sent | hired | declined | rejected
  statusHistory       String? // JSON: [{status, changedAt}]
  contactedAt         DateTime?
  source              String    @default("manual") // manual | serpapi | pdl | extension | talent_pool | jobadder_import | seek | scraper
  // Recruiter-set marker. "preferred" → boost in shortlists; "excluded" →
  // hide from search results. Mirrors JobAdder's Suitability field. Null is
  // the default neutral state. Library list + multi-source search will use
  // this to gate cross-job recommendations.
  suitability         String?   // "preferred" | "excluded" | null
  // References CandidateFile.id of the recruiter-uploaded headshot. The
  // Avatar component fetches /api/candidates/<id>/files/<photoFileId>?inline=1
  // to render the image (same encryption + auth path as CVs). Nullable —
  // most candidates have no photo and the Avatar falls back to initials.
  photoFileId         String?
  profileCapturedAt   DateTime?
  captureMetadata     String? // JSON: extension capture metadata — which deep pages were fetched, status, chars added, merge mode

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  references       ReferenceCheck[]
  files            CandidateFile[]
  fetchSessions    FetchSession[]
  scoreCorrections ScoreCorrection[]
  contactEvents    ContactEvent[]
  submissions      Submission[]
  tagAssignments   CandidateTagAssignment[]

  @@unique([jobId, linkedinUrl])
  @@index([linkedinUrl]) // talent pool cross-job URL lookups
  // NOTE: the Candidate.seekUrl index is a PARTIAL index (WHERE seekUrl IS
  // NOT NULL) created in scripts/apply-schema-changes.mjs step 24 — NOT
  // declared here, so `prisma db push` doesn't try to replace it with a
  // non-partial index of the same name (the conflict we hit with an earlier
  // partial index). Same pattern as the suitability index.
  @@index([orgId])
  @@index([status])
  @@index([orgId, createdAt]) // timeline queries in candidates library
  @@index([orgId, profileCapturedAt]) // dashboard "needs fetch" query
  @@index([jobId, matchScore]) // shortlist + job views frequently order by matchScore desc
  @@index([candidateIdentityId]) // joins from CandidateIdentity → all candidate rows for one person
}

model CandidateFile {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String // "cv" | "cover_letter" | "other"
  filename    String
  mimeType    String
  data        String // base64 encoded file content
  size        Int // original size in bytes
  // SHA-256 (first 32 hex chars) of the raw file bytes. Set on every new
  // upload; nullable for pre-existing rows that haven't been backfilled.
  // Used to detect duplicate uploads without loading every existing file's
  // base64 blob into memory (the prior dedup loop scaled to ~13MB read
  // per upload for power users with 50 CVs).
  dataHash    String?
  createdAt   DateTime  @default(now())

  // Uniqueness on (candidateId, dataHash) is now enforced at the DB level —
  // POST in src/app/api/candidates/[id]/files/route.ts has a fast-path dup
  // check, but two concurrent uploads from different tabs can both pass that
  // check and race to insert. The unique constraint plus a P2002 catch in
  // the route turns the second one into a 200 "duplicate" response instead
  // of a 500. NULL-valued dataHash rows (legacy pre-hash uploads) are NOT
  // covered — Postgres treats NULLs as distinct in unique indexes, which is
  // the behaviour we want for those rows.
  @@unique([candidateId, dataHash])
}

// Replaces the Setting-JSON extension queue — proper indexed table per session.
model FetchSession {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  linkedinUrl   String
  candidateName String    @default("")
  status        String    @default("pending") // pending | processing | completed | error
  message       String    @default("")
  error         String?
  completedAt   DateTime?
  orgId         String?
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([candidateId])
  @@index([jobId])
  @@index([status])
  // The recovery-on-mount query in jobs/[id]/page.tsx filters by
  // (jobId, status in [pending, processing]). Without this composite the
  // status filter forces a full scan of all sessions for the job.
  @@index([jobId, status])
  // Per-org "what's pending across all my jobs?" queries used by the popup.
  @@index([orgId, status])
}

// Reusable named scoring-weight presets per org. A preset is a snapshot of
// ScoringWeights stored under a recruiter-chosen label like "Sales-heavy" or
// "Engineer · Wellington" that can be applied to a specific job in one click.
model ScoringWeightPreset {
  id        String   @id @default(cuid())
  orgId     String?
  name      String
  weights   String // JSON: ScoringWeights
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name]) // preset names are unique per org
  @@index([orgId])
}

// Log of every time a recruiter contacts a candidate — prevents two agents
// messaging the same person blind and gives a shared audit trail.
model ContactEvent {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  orgId       String?
  userId      String // who logged it
  userName    String // display name snapshot so it shows even if user is deleted
  // Which role the contact was about. Optional — older events have null.
  // Not a hard FK so the event survives if the job is deleted; we resolve
  // titles via a separate Job lookup at read time.
  jobId       String?
  type        String // "message" | "call" | "email" | "ai_outreach_generated" | "other"
  note        String? // optional free text
  createdAt   DateTime  @default(now())

  @@index([candidateId])
  @@index([orgId])
  @@index([jobId])
}

// Recruiter score corrections — captures explicit "this score is wrong" signals.
// Fed back into the scoring prompt as calibration examples so similar future
// candidates score closer to the recruiter's mental model.
model ScoreCorrection {
  id             String    @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId          String? // captured at correction time so we can match against role-similar past corrections
  orgId          String?
  originalScore  Int // matchScore at correction time
  recruiterScore Int // 0-100, what the recruiter thinks the score should be
  reason         String? // optional free text explanation
  roleTitle      String? // snapshot of parsedRole.title at correction time for similarity match
  createdAt      DateTime  @default(now())

  @@index([orgId])
  @@index([candidateId])
}

// User-named, re-runnable search definitions — recruiters often run the same
// search weekly without wanting to re-type queries/location/target.
model SavedSearch {
  id              String    @id @default(cuid())
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orgId           String?
  name            String // recruiter-chosen label, e.g. "React leads in Auckland"
  queries         String // JSON: string[]
  location        String
  target          Int       @default(20)
  lastRunAt       DateTime?
  lastResultCount Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([jobId, name]) // saved-search names are unique per job
  @@index([jobId])
  @@index([orgId])
}

// Persists search progress so partial results survive rate-limit interruptions.
model SearchSession {
  id                 String   @id @default(cuid())
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status             String   @default("running") // running | complete | rate_limited
  queries            String // JSON: string[]
  location           String
  collected          Int      @default(0)
  target             Int
  page               Int      @default(0)
  importedIds        String   @default("[]") // JSON: candidateId[]
  message            String?
  orgId              String?
  // Self-evaluation written at completion
  avgScore           Float?
  candidatesRejected Int?
  totalExamined      Int?
  evaluation         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([jobId])
  // Search-funnel and history queries filter by (jobId, status in [running, complete]).
  @@index([jobId, status])
}

model JobParseHistory {
  id            String   @id @default(cuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parsedAt      DateTime @default(now())
  anchorTerms   String // JSON: string[]
  mustHaveCount Int
  changes       String // JSON: string[]
  evaluation    String

  @@index([jobId])
}

// DB-backed login attempt tracking — survives server restarts and horizontal scaling.
model LoginAttempt {
  id      String   @id @default(cuid())
  key     String   @unique // lowercase username — @unique already creates the lookup index
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt]) // for nightly cleanup: delete WHERE resetAt < NOW()
}

// Tracks billable/auditable API usage per org. Used for rate limiting and metering.
model UsageEvent {
  id           String   @id @default(cuid())
  orgId        String?
  userId       String?
  type         String // "search" | "score" | "score_all" | "capture" | "parse" | "ai_call" | "insight_extract"
  meta         String? // JSON: extra context (jobId, count, etc.)
  // AI cost tracking — populated on type="ai_call" events written by chat.ts.
  // Nullable so the existing rate-limit event types (score, parse, etc.) keep working.
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  @@index([orgId, type, createdAt])
  @@index([orgId, createdAt])
}

// Per-(org, real-person) identity row. One row per human as recognised by
// recruiter-truth keys (LinkedIn URL, JobAdder URL, email, phone). Multiple
// Candidate rows (per-job applications) point at the same identity. Insights
// (AI-extracted universal facts) live on ProfileInsight, also per-org.
//
// Cross-org isolation is NON-NEGOTIABLE: even when OrgAccessGrant lets one
// org read another's library rows, identities and insights are still scoped
// to the owning org. See plan §A decision #5.
model CandidateIdentity {
  id                   String   @id @default(cuid())
  orgId                String
  org                  Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  canonicalName        String // Latest known display name; updated when alias evidence improves
  primaryEmail         String? // Lowercased, plus-tag preserved; treat as identity hint, not unique
  primaryPhone         String? // E.164 normalised when available
  linkedinUrl          String? // Canonical (current) LinkedIn URL; previous values move to alias rows
  jobAdderUrl          String? // Canonical (current) JobAdder URL; previous values move to alias rows
  seekUrl              String? // Canonical (current) SEEK URL; previous values move to alias rows
  // When a merge collapses this identity into a survivor, the merger sets this.
  // Queries follow this chain to find the canonical identity. Splits (unmerge)
  // null this back out and write a tombstone CandidateIdentityMerge row.
  mergedIntoIdentityId String?
  // Latest valid ProfileInsight for this identity. Denormalised so the read
  // path doesn't have to find-the-newest-non-superseded for every join.
  currentInsightId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  candidates Candidate[]
  aliases    CandidateIdentityAlias[]
  insights   ProfileInsight[]

  // Same person legitimately exists across orgs; uniqueness is per-org only.
  // jobAdderUrl uniqueness within an org prevents auto-merging two subsidiaries
  // that share one JobAdder tenant — never collapse jobAdderUrl across orgs.
  @@unique([orgId, linkedinUrl])
  @@unique([orgId, jobAdderUrl])
  // seekUrl uniqueness within an org, same rationale as jobAdderUrl: never
  // collapse a SEEK URL across orgs (two tenants can share a SEEK board).
  @@unique([orgId, seekUrl])
  @@index([orgId])
  @@index([orgId, primaryEmail])
  @@index([mergedIntoIdentityId])
}

// History of identity-resolution keys. Lets an identity survive a LinkedIn URL
// rename or a candidate switching email/phone without splitting. validTo set
// when a newer alias supersedes this one; otherwise null = current.
model CandidateIdentityAlias {
  id         String            @id @default(cuid())
  identityId String
  identity   CandidateIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  kind       String // 'linkedinUrl' | 'email' | 'phone' | 'jobAdderUrl' | 'seekUrl'
  value      String
  source     String // 'extraction' | 'recruiter' | 'system' (clustering script)
  validFrom  DateTime          @default(now())
  validTo    DateTime?

  @@index([identityId])
  @@index([kind, value])
}

// Merge audit. Every auto- or recruiter-confirmed merge writes one row.
// Tombstone rows (isTombstone=true) record a deliberate UNMERGE and prevent
// any auto-merge logic from re-collapsing the same (source, survivor) pair —
// without this, the next nightly clustering pass silently re-merges what the
// recruiter just split. See Critic A §1.4.
model CandidateIdentityMerge {
  id                 String   @id @default(cuid())
  orgId              String
  sourceIdentityId   String // identity that was absorbed (or unmerged from)
  survivorIdentityId String
  mergedByUserId     String? // null for auto-merges by clustering script
  mergedAt           DateTime @default(now())
  reason             String // 'auto_linkedin' | 'auto_jobadder' | 'recruiter_confirm' | 'unmerge'
  isTombstone        Boolean  @default(false)

  // Single tombstone per (source, survivor) — re-running cluster shouldn't
  // duplicate rows. Auto-merges may legitimately repeat (e.g. re-clustering
  // after a new alias) so they are NOT covered by this constraint.
  @@unique([orgId, sourceIdentityId, survivorIdentityId, isTombstone])
  @@index([orgId, survivorIdentityId])
  @@index([orgId, sourceIdentityId])
}

// Versioned AI-extracted reusable facts about an identity. Per-(orgId,
// identityId) — never shared across orgs even when OrgAccessGrant exists.
// Stale detection is hash-based: when Candidate.profileText changes, its hash
// changes, and a new ProfileInsight row is extracted for the new hash. Old
// rows stay as audit history (supersededAt set), so we can compare extractions
// across prompt versions.
//
// The actual extractor + write path land in PR 2. PR 1 ships only the table
// so the FK from CandidateIdentity.currentInsightId can reference it.
model ProfileInsight {
  id                    String            @id @default(cuid())
  orgId                 String
  identityId            String
  identity              CandidateIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  factsJson             String // JSON: primaryStack, domains, titlesHeld, evidenceSnippets, etc.
  extractionVersion     Int // Gate for Stage 1 ranker; bumped only after re-extraction sweep
  promptVersion         String // e.g. "insight-v1.0" — bumped on prompt edits
  extractedBy           String // "claude" | "openai" | "deterministic"
  modelId               String // exact model id at extraction time
  sourceProfileTextHash String // SHA-256 of normalised profileText that was the input (single-platform legacy)
  sourceInputHash       String? // SHA-256 of combined multi-platform input; replaces sourceProfileTextHash for new rows
  contributingPlatforms String  @default("[]") // JSON: [{platform, candidateId, charCount}]
  sourceCandidateId     String? // which Candidate row was the longest-text source
  extractedAt           DateTime          @default(now())
  supersededAt          DateTime?

  // Idempotency: re-running the extractor with the same inputs is a no-op.
  @@unique([orgId, identityId, sourceProfileTextHash, extractionVersion])
  @@index([orgId, identityId, supersededAt])
  @@index([orgId, extractionVersion])
}

model ReferenceCheck {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  refereeName    String
  refereeTitle   String?
  refereeCompany String?
  refereeEmail   String?
  refereePhone   String?
  relationship   String? // "Direct manager" | "Peer" | "Report" | "Client"

  status    String  @default("pending") // pending | contacted | received | complete
  questions String? // JSON: [{question, category}]
  responses String? // JSON: [{question, answer}]
  summary   String? // AI-generated paragraph

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
