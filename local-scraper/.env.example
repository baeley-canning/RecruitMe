# Shared secret. Must match SCRAPER_API_KEY in Railway → RecruitMe service.
SCRAPER_API_KEY=

# LinkedIn auth — preferred is LI_AT (cookie). Get it from:
#   Chrome DevTools → Application → Cookies → linkedin.com → li_at → copy "Value"
LINKEDIN_LI_AT=

# Fallback: email + password. May trip a CAPTCHA on first run.
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=

# Optional. Default 8080.
# PORT=8080

# Run Chrome invisibly. Default false (visible Chrome is harder to detect).
# HEADLESS=false
